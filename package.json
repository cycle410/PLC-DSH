{
  "name": "@local/dsh-agentplc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Left-sidebar PLC engineering workspace for OMRON Sysmac Studio and Siemens TIA Portal.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plc",
    "omron",
    "sysmac-studio",
    "tia-portal",
    "siemens",
    "structured-text"
  ],
  "scripts": {
    "check": "node scripts/check-tool-schemas.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "powershell",
    "python",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}
